# Environment variables for ML Identity Threat Simulator
# Copy this file to .env and fill in your values

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_ORGANIZATION_ID=your-org-id

# Logging Configuration
IAM_SIMULATOR_LOGGING_LEVEL=INFO
IAM_SIMULATOR_LOGGING_FILE=

# Application Configuration (optional overrides)
# IAM_SIMULATOR_RISKY_ROLES=roles/owner,roles/editor
# IAM_SIMULATOR_WILDCARD_MEMBERS=allUsers,allAuthenticatedUsers
